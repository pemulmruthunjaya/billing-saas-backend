# Local development uses NODE_ENV=development.
# Live deployment must use NODE_ENV=production.
NODE_ENV=development
PORT=3000

DB_HOST=your-database-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=your-database-name

# Minimum 32 characters. Use a random value and never share it.
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-characters
JWT_EXPIRES_IN=1d

# Local: http://localhost:5173
# Live: https://your-frontend-domain.com
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=1mb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20

BACKUP_COMPANY_ID=
BACKUP_DIR=backups
